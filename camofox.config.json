{
  "id": "camofox-browser",
  "name": "Camofox Browser",
  "version": "1.6.0",
  "newPageTimeoutMs": 10000,
  "interactive": { "mode": "off" },
  "plugins": {
    "youtube": { "enabled": true },
    "persistence": { "enabled": true },
    "vnc": { "enabled": true, "resolution": "1920x1080", "publishDisplay": false },
    "geo-rpa": {
      "enabled": true,
      "manualWindowVnc": {
        "enabled": true,
        "rfbPort": 5901,
        "websocketPort": 6081
      }
    }
  }
}
