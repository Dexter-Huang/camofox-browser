# CI/CD Dockerfile — downloads binaries during build (no bind mounts needed).
# For local builds with pre-downloaded binaries, use the default Dockerfile + Makefile.

FROM node:22-trixie-slim

ARG CAMOUFOX_VERSION=135.0.1
ARG CAMOUFOX_RELEASE=beta.24
ARG TARGETARCH
# 国内 CI 默认使用镜像站；海外构建可显式传入官方地址覆盖。
ARG DEBIAN_MIRROR=http://mirrors.tuna.tsinghua.edu.cn
ARG NPM_REGISTRY=https://registry.npmmirror.com

# Install dependencies for Camoufox (Firefox-based)
# node:22-trixie-slim 使用 deb822 源文件。替换 host 会同时覆盖主仓库与安全更新仓库，
# 仍通过 Debian archive keyring 校验软件包签名。
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && npm config set registry "${NPM_REGISTRY}" \
    # package-lock.json 固定了 npmjs tarball URL；强制重写后 npm ci 才会使用指定镜像。
    && npm config set replace-registry-host always \
    && apt-get update && apt-get install -y \
    # Firefox dependencies
    libgtk-3-0 \
    libdbus-glib-1-2 \
    libxt6 \
    libasound2 \
    libx11-xcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    # Mesa OpenGL/EGL for WebGL support (software rendering via llvmpipe)
    # `libegl1-mesa` was dropped in Debian trixie.
    libegl1 \
    libgl1-mesa-dri \
    libgbm1 \
    # Xvfb virtual display
    xvfb \
    # Fonts
    fonts-liberation \
    fonts-noto-color-emoji \
    fontconfig \
    # Utils
    ca-certificates \
    curl \
    unzip \
    # Native-module build tools. better-sqlite3 may compile from source on arm64.
    build-essential \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# 本地预置的 Camoufox 发行包会被纳入 Docker 构建上下文，但被 .gitignore 排除。
# 该 CI Dockerfile 目前只支持 x86_64 包，构建时必须传入 TARGETARCH=amd64。
COPY bin/camoufox-135.0.1-beta.24-lin.x86_64.zip /tmp/camoufox.zip
COPY bin/yt-dlp_linux /usr/local/bin/yt-dlp
COPY bin/yt-dlp /app/bin/yt-dlp

# Install the pre-downloaded Camoufox bundle and validate its architecture.
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) ;; \
      *) echo "This local Camoufox bundle only supports TARGETARCH=amd64" && exit 1 ;; \
    esac; \
    mkdir -p /home/node/.cache/camoufox; \
    # Camoufox 内含跨平台字体文件名，unzip 会在 Windows 打包的 archive 上返回警告退出码。
    # 后续 camoufox-bin 检查确保警告不会掩盖不完整的浏览器包。
    (unzip -q /tmp/camoufox.zip -d /home/node/.cache/camoufox || true); \
    chmod -R 755 /home/node/.cache/camoufox; \
    chown -R node:node /home/node/.cache/camoufox; \
    echo "{\"version\":\"${CAMOUFOX_VERSION}\",\"release\":\"${CAMOUFOX_RELEASE}\"}" > /home/node/.cache/camoufox/version.json; \
    chown node:node /home/node/.cache/camoufox/version.json; \
    test -f /home/node/.cache/camoufox/camoufox-bin && echo "Camoufox installed successfully"; \
    rm /tmp/camoufox.zip; \
    chmod 755 /usr/local/bin/yt-dlp

WORKDIR /app

COPY package.json package-lock.json ./
COPY scripts/ ./scripts/
# Build tools are needed when better-sqlite3 has no native prebuild for the target.
# Trixie's glibc also supports the upstream arm64 prebuild at runtime.
RUN npm ci --omit=dev \
    && apt-get purge -y --auto-remove build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY server.js ./
COPY camofox.config.json ./
COPY lib/ ./lib/
# lib/cookies.js re-exports mcp/lib/cookies.mjs for persistence support.
COPY mcp/ ./mcp/
COPY plugins/ ./plugins/
COPY scripts/ ./scripts/

# Install default plugin dependencies
# Note: sh is used explicitly (./scripts/) because COPY from Windows
# does not preserve +x permission bits in Docker build contexts.
RUN sh scripts/install-plugin-deps.sh

# 与 Compose 的持久化 profile 卷所有者一致，避免运行时缓存落入 root 用户目录。
USER node

ENV NODE_ENV=production
ENV CAMOFOX_PORT=9377

EXPOSE 9377

CMD ["sh", "-c", "node --max-old-space-size=${MAX_OLD_SPACE_SIZE:-128} server.js"]
