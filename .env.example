# 日常同机部署不必复制本文件：直接 docker compose up -d 即绑定 127.0.0.1:9377。
# 仅在需要改绑定 IP 或端口时复制为 .env。
# cp .env.example .env
#
# 本文件只给 Camofox Compose 用。GEO 应用机的 CAMOFOX_BROWSER_URL、数据库、JWT 不要写这里。
# 不要把仓库根目录 .env.deploy 复制到这里。

# 同机保持 127.0.0.1。分机改成浏览器服务器私网 IP。禁止绑 0.0.0.0 到公网。
CAMOFOX_BIND_ADDRESS=127.0.0.1
CAMOFOX_CONTROL_HOST_PORT=9377

# RFB / 任务观察 WS 端口段，长度需覆盖 RPA_BROWSER_CAPACITY。
CAMOFOX_RFB_HOST_PORT_START=5902
CAMOFOX_RFB_HOST_PORT_END=5931
CAMOFOX_WS_HOST_PORT_START=6082
CAMOFOX_WS_HOST_PORT_END=6111

CAMOFOX_COMPOSE_PROJECT_NAME=geo-camofox
RPA_BROWSER_CAPACITY=30
RPA_MANUAL_SESSION_MAX_CONCURRENT=0
RPA_MANUAL_WINDOW_CREATE_CONCURRENCY=2
RPA_WINDOW_PUBLISHER_GRID_COLUMNS=5
CAMOFOX_TIMEZONE=Asia/Shanghai
CAMOFOX_VNC_RESOLUTION=1920x1080x24

# 镜像名与构建源。本机已有镜像时可不改。
CAMOFOX_BROWSER_BASE_IMAGE=geo-camofox-browser-base:py312-camoufox152.0.4b29
CAMOFOX_BROWSER_IMAGE=geo-camofox-browser:local
CAMOFOX_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
